      "then": {
        "properties": {
          "family_insurance_details": {
            "required": [
              "has_spouse_health_insurance"
            ]
          }
        },
        "required": [
          "partner_details"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "children": false,
          "deduct_insurance_from_salary": false,
          "has_child_health_insurance": false,
          "has_spouse_health_insurance": false
