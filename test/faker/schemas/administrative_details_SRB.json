      },
      "if": {
        "properties": {
          "has_insurance": {
            "const": "yes"
          }
        },
        "required": [
          "has_insurance"
        ]
      },
      "then": {
        "required": [
          "deduct_insurance_from_salary",
          "has_spouse_health_insurance",
          "has_child_health_insurance"
        ]
      }
    },
    {
