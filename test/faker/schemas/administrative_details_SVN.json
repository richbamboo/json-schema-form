      "oneOf": [
        {
          "const": "yes",
          "title": "Yes"
        },
        {
          "const": "no",
          "title": "No"
        }
      ],
      "title": "Will you apply for a Tax Relief for Dependent Family Members? (Uveljavlja olajšavo za družinske člane)",
      "type": "string",
      "x-jsf-presentation": {
        "direction": "row",
        "inputType": "radio"
      }
