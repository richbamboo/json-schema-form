    "tax_relief_general_claims": {
      "description": "This applies to employees whose annual tax base is lower than 16000 EUR.",
      "oneOf": [
        {
          "const": "yes",
          "title": "Yes"
        },
        {
          "const": "no",
          "title": "No"
        }
      ],
      "title": "Are you eligible for an additional tax relief?",
      "type": "string",
      "x-jsf-presentation": {
        "direction": "row",
        "inputType": "radio"
      }
