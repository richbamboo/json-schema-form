  ],
  "type": "object",
  "x-jsf-order": [
    "id_number_type",
    "id_number",
    "has_tax_number",
    "tax_number",
    "degree_details",
    "previous_years_of_experience",
    "tax_relief_family_members",
    "tax_relief_general_claims"
  ]
