    {
      "else": {
        "properties": {
          "tax_number": false
        }
      },
      "if": {
        "properties": {
          "has_tax_number": {
            "const": "yes"
          }
        },
        "required": [
          "has_tax_number"
        ]
      },
      "then": {
        "required": [
          "tax_number"
        ]
      }
    }
  ],
  "properties": {
    "degree_details": {
      "properties": {
        "level_of_education": {
          "description": "Please select your level of education.",
          "enum": [
            "high_school",
            "bachelor",
            "master",
            "doctorate_postdoctorate"
          ],
          "oneOf": [
            {
              "const": "high_school",
              "title": "High School/equivalent"
            },
            {
              "const": "bachelor",
              "title": "Bachelor's Degree"
            },
            {
              "const": "master",
              "title": "Master's Degree"
            },
            {
              "const": "doctorate_postdoctorate",
              "title": "Doctorate or Post-doctorate"
            }
          ],
          "title": "Level of Education",
          "type": "string",
          "x-jsf-presentation": {
            "inputType": "select"
          }
        },
        "title": {
          "description": "Please insert the title achieved. You can find a list of the fields of education in Slovenia <a href='https://docs.google.com/spreadsheets/d/1Qh9IhwCsSmEB0jAMSCOVzrFX7htBGxa9' target='_blank' rel='noopener noreferrer'>here</a>.",
          "maxLength": 255,
          "title": "Title achieved (Naziv izobrazbe)",
          "type": "string",
          "x-jsf-presentation": {
            "inputType": "text"
          }
        }
      },
      "required": [
        "level_of_education",
        "title"
      ],
      "title": "Education",
      "type": "object",
      "x-jsf-order": [
        "level_of_education",
        "title"
      ],
      "x-jsf-presentation": {
        "inputType": "fieldset"
      }
    },
    "has_tax_number": {
      "oneOf": [
        {
          "const": "yes",
          "title": "Yes"
        },
        {
          "const": "no",
          "title": "No"
        }
      ],
      "title": "Do you have a Slovenian Tax Number (Davčna številka)?",
      "type": "string",
      "x-jsf-presentation": {
        "direction": "row",
        "inputType": "radio"
      }
    },
    "id_number": {
      "description": "Please provide the number from your Passport or ID (EMŠO)",
      "maxLength": 255,
      "title": "ID/Passport number",
      "type": "string",
      "x-jsf-presentation": {
        "inputType": "text",
        "maskSecret": 3
      }
    },
    "id_number_type": {
      "oneOf": [
        {
          "const": "national_id_number",
          "title": "ID number (EMŠO)"
