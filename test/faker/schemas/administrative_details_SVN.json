        {
          "const": "passport",
          "title": "Passport number"
        }
      ],
      "title": "ID number type",
      "type": "string",
      "x-jsf-presentation": {
        "inputType": "select"
      }
    },
    "previous_years_of_experience": {
      "oneOf": [
        {
          "const": "yes",
          "title": "Yes"
        },
        {
          "const": "no",
          "title": "No"
        }
      ],
      "title": "Have you been employed before?",
      "type": "string",
      "x-jsf-presentation": {
        "direction": "row",
        "inputType": "radio"
      }
    },
    "tax_number": {
      "maxLength": 255,
      "title": "Tax Number (Davčna številka)",
      "type": "string",
      "x-jsf-presentation": {
        "inputType": "text"
      }
    },
    "tax_relief_family_members": {
